maximize = true

# 外観設定
theme = Kanagawa Dragon
background = black
background-opacity = 0.85
background-blur = 20
cursor-opacity = 0.7
split-divider-color = #959fb4

# フォントの設定
font-size = 16
font-family = "JetBrains Mono"
font-family = "Zen Kaku Gothic New Medium"

# 入力時にマウスカーソルを非表示
mouse-hide-while-typing = true

# 起動時に前回の画面サイズを引き継ぐ
window-save-state = always

# 範囲選択したテキストを自動でコピー
copy-on-select = clipboard

# リガチャ無効化
font-feature = "-calt"
font-feature = "-dlig"
font-feature = "-liga"

# shift+enterを改行扱いとする
keybind = shift+enter=text:\x0d

# ペインリサイズ
keybind = control+cmd+right=resize_split:right,30
keybind = control+cmd+left=resize_split:left,30
keybind = control+cmd+up=resize_split:up,30
keybind = control+cmd+down=resize_split:down,30
