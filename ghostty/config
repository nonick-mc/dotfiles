
maximize = true

# 外観設定
theme = "Kanagawa Wave"
background = "000000"
split-divider-color = #ffffff
background-opacity = 0.85
background-blur = 20

# フォントの設定
font-size = 17
font-family = "JetBrains Mono"
font-family = "Zen Kaku Gothic New Medium"

# 起動時に前回の画面サイズを引き継ぐ
window-save-state = always

# 範囲選択したテキストを自動でコピー
copy-on-select = clipboard

# リガチャ無効化
font-feature = "-calt"
font-feature = "-dlig"
font-feature = "-liga"

# shift+enterを改行扱いとする
keybind = shift+enter=text:\x0d

# ペインリサイズ
keybind = control+cmd+right=resize_split:right,30
keybind = control+cmd+left=resize_split:left,30
keybind = control+cmd+up=resize_split:up,30
keybind = control+cmd+down=resize_split:down,30
