theme = "Kanagawa Wave"
background = "000000"
font-size = 17

window-padding-x = 10
window-padding-y = 10
window-decoration = true
window-padding-balance = true

background-opacity = 0.85
background-blur = 20

# 起動時に前回の画面サイズを引き継ぐ
window-save-state = always

# 範囲選択したテキストを自動でコピー
copy-on-select = clipboard

# リガチャ無効化
font-feature = "-calt"
font-feature = "-dlig"
font-feature = "-liga"

# shift+enterを改行扱いとする
keybind = shift+enter=text:\x0d
