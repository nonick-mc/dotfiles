maximize = true

# 外観設定
theme = Kanagawa Dragon
background = black
background-opacity = 0.85
background-blur = 20
cursor-opacity = 0.7
split-divider-color = #959fb4

# フォントの設定
font-size = 17
font-family = "JetBrains Mono"
font-family = "Hiragino Sans"

# 入力時にマウスカーソルを非表示
mouse-hide-while-typing = true

# 起動時に前回の画面サイズを引き継ぐ
window-save-state = always

# 範囲選択したテキストを自動でコピー
copy-on-select = clipboard

# リガチャ無効化
font-feature = "-calt"
font-feature = "-dlig"
font-feature = "-liga"

# shift+enterを改行扱いとする
keybind = shift+enter=text:\n

# ペイン移動
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# ペインリサイズ
keybind = control+cmd+l=resize_split:right,30
keybind = control+cmd+h=resize_split:left,30
keybind = control+cmd+k=resize_split:up,30
keybind = control+cmd+j=resize_split:down,30
